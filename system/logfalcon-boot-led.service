# Heartbeat LED during boot — lets the pilot know the Pi is alive.
# Starts before sysinit; synchronously stopped by the status LED service.
# Install to: /etc/systemd/system/logfalcon-boot-led.service

[Unit]
Description=LogFalcon Boot LED Heartbeat
DefaultDependencies=no
Before=sysinit.target

[Service]
Type=simple
ExecStart=/opt/logfalcon/boot-led.sh
Restart=no
TimeoutStopSec=3s

[Install]
WantedBy=sysinit.target
