# One privileged owner of the LED; outcomes come from shared sync status.
# Install to: /etc/systemd/system/logfalcon-ready-led.service

[Unit]
Description=LogFalcon Ready LED
After=sysinit.target logfalcon-runtime.service logfalcon-config-apply.service
Requires=logfalcon-runtime.service

[Service]
Type=simple
# sysinit ordering completes boot-helper startup first. No direct ordering edge
# to that helper: its stop job must be able to run during this start job.
ExecStartPre=/usr/bin/systemctl stop logfalcon-boot-led.service
ExecStart=/opt/logfalcon/logfalcon --led-status
TimeoutStartSec=10s
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
