# systemd unit for LogFalcon web server (always running)
# Install to: /etc/systemd/system/logfalcon-web.service
# Enable: sudo systemctl enable --now logfalcon-web.service

[Unit]
Description=LogFalcon Web Server
Documentation=https://github.com/proeugene/logfalcon
After=logfalcon-config-apply.service network.target hostapd.service logfalcon-runtime.service
Requires=logfalcon-runtime.service logfalcon-config-apply.service

[Service]
Type=simple
User=bbsyncer
Group=bbsyncer

WorkingDirectory=/opt/logfalcon
ExecStart=/opt/logfalcon/logfalcon --web

StandardOutput=journal
StandardError=journal
SyslogIdentifier=logfalcon-web

Restart=always
RestartSec=5

# Allow binding to port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Resource limits — cgroup v2 memory guard (Pi Zero W has 512 MB RAM)
MemoryHigh=300M
MemoryMax=350M

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

# Filesystem access — log storage, config, and hostapd settings
ReadWritePaths=/mnt/logfalcon-logs /etc/logfalcon /run/logfalcon

[Install]
WantedBy=multi-user.target
