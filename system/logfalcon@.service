# systemd template unit for LogFalcon sync service
# Install to: /etc/systemd/system/logfalcon@.service
# Triggered by udev when FC is plugged in (e.g. logfalcon@ttyACM0.service)

[Unit]
Description=LogFalcon (%I)
Documentation=https://github.com/proeugene/logfalcon
# Stop if the device disappears mid-sync
BindsTo=dev-%i.device
After=dev-%i.device local-fs.target logfalcon-diagnostics.service
Requires=logfalcon-runtime.service logfalcon-config-apply.service
After=logfalcon-runtime.service logfalcon-config-apply.service

[Service]
Type=oneshot
# Wait for USB enumeration to stabilise
ExecStartPre=/bin/sleep 3

User=bbsyncer
Group=dialout

# Install location
WorkingDirectory=/opt/logfalcon
ExecStart=/opt/logfalcon/logfalcon --port /dev/%I

StandardOutput=journal
StandardError=journal
SyslogIdentifier=logfalcon

# Resource limits — cgroup v2 memory guard (Pi Zero W has 512 MB RAM)
# MemoryHigh=300M: kernel throttles allocations above this threshold
# MemoryMax=350M: hard ceiling — OOM-kill the unit if exceeded
MemoryHigh=300M
MemoryMax=350M
TimeoutStartSec=630
TimeoutStopSec=10

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

# Filesystem access — log storage, config, and LED sysfs
ReadWritePaths=/mnt/logfalcon-logs /run/logfalcon

# Export asynchronously, including failures. Never delay the copy process.
ExecStopPost=-+/usr/bin/systemctl --no-block start logfalcon-diagnostics-export.service

# Do not restart on failure — the pilot will re-plug the FC
Restart=no

[Install]
WantedBy=multi-user.target
